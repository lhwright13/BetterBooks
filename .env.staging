# Environment configuration for staging deployment
# Copy to .env and customize for your environment

# === DATABASE CONFIGURATION ===
POSTGRES_HOST=postgres-staging.internal
POSTGRES_PORT=5432
POSTGRES_DB=echowright_staging
POSTGRES_USER=echowright_staging
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}  # Set via CI/CD variables

# === REDIS CONFIGURATION ===
REDIS_HOST=redis-staging.internal
REDIS_PORT=6379
REDIS_PASSWORD=${REDIS_PASSWORD}  # Set via CI/CD variables

# === EXTERNAL API KEYS ===
GEMINI_API_KEY=${GEMINI_API_KEY_STAGING}  # Set via CI/CD variables

# === SERVICE URLS ===
API_GATEWAY_URL=https://staging.echowright.com
CONTEXT_SERVICE_URL=http://context-service:8001
LLM_GATEWAY_URL=http://llm-gateway:8002
TTS_SERVICE_URL=http://tts-service:8003
TRANSCRIPTION_SERVICE_URL=http://transcription-service:8004

# === SECURITY ===
JWT_SECRET_KEY=${JWT_SECRET_KEY_STAGING}  # Set via CI/CD variables
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# === LOGGING ===
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_REQUEST_LOGGING=true

# === PERFORMANCE ===
WORKER_CONNECTIONS=1000
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT=30
KEEP_ALIVE_TIMEOUT=5

# === FEATURES ===
ENVIRONMENT=staging
DEBUG=false
ENABLE_METRICS=true
ENABLE_TRACING=true
ENABLE_CACHING=true

# === CORS ===
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true

# === RATE LIMITING ===
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=3600

# === CACHING ===
CACHE_TTL=300
CACHE_MAX_SIZE=100000

# === MONITORING ===
PROMETHEUS_PORT=9090
JAEGER_ENDPOINT=http://jaeger-collector.monitoring:14268/api/traces
JAEGER_SAMPLING_RATE=1.0

# === FILE STORAGE ===
UPLOAD_MAX_SIZE=50MB
AUDIO_STORAGE_PATH=/tmp/audio
TTS_MODEL_CACHE_PATH=/tmp/models

# === AI CONFIGURATION ===
MOCK_EXTERNAL_APIS=false
LLM_MAX_TOKENS=4000
LLM_TEMPERATURE=0.7
TTS_DEFAULT_VOICE=default
TTS_DEFAULT_SPEED=1.0

# === HEALTH CHECKS ===
HEALTH_CHECK_TIMEOUT=10
DEPENDENCY_TIMEOUT=5