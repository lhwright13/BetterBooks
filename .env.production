# Environment configuration for production deployment
# Managed via external secrets in production

# === DATABASE CONFIGURATION ===
POSTGRES_HOST=postgres-prod.internal
POSTGRES_PORT=5432
POSTGRES_DB=echowright_prod
POSTGRES_USER=echowright_prod
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}  # Managed via Vault/AWS Secrets

# === REDIS CONFIGURATION ===
REDIS_HOST=redis-prod.internal
REDIS_PORT=6379
REDIS_PASSWORD=${REDIS_PASSWORD}  # Managed via Vault/AWS Secrets
REDIS_CLUSTER_ENABLED=true

# === EXTERNAL API KEYS ===
GEMINI_API_KEY=${GEMINI_API_KEY_PROD}  # Managed via Vault/AWS Secrets

# === SERVICE URLS ===
API_GATEWAY_URL=https://echowright.com
CONTEXT_SERVICE_URL=http://context-service:8001
LLM_GATEWAY_URL=http://llm-gateway:8002
TTS_SERVICE_URL=http://tts-service:8003
TRANSCRIPTION_SERVICE_URL=http://transcription-service:8004

# === SECURITY ===
JWT_SECRET_KEY=${JWT_SECRET_KEY_PROD}  # Managed via Vault/AWS Secrets
JWT_ALGORITHM=RS256  # More secure for production
JWT_EXPIRATION_HOURS=2  # Shorter expiration
SECURE_COOKIES=true
CSRF_PROTECTION=true

# === LOGGING ===
LOG_LEVEL=WARNING  # Less verbose in production
LOG_FORMAT=json
ENABLE_REQUEST_LOGGING=true
AUDIT_LOGS_ENABLED=true

# === PERFORMANCE ===
WORKER_CONNECTIONS=2000
MAX_CONCURRENT_REQUESTS=500
REQUEST_TIMEOUT=60
KEEP_ALIVE_TIMEOUT=65

# === FEATURES ===
ENVIRONMENT=production
DEBUG=false
ENABLE_METRICS=true
ENABLE_TRACING=true
ENABLE_CACHING=true
ENABLE_PROFILING=false  # Disabled in production

# === CORS ===
CORS_ORIGINS=https://echowright.com,https://www.echowright.com
CORS_ALLOW_CREDENTIALS=true

# === RATE LIMITING ===
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=3600
RATE_LIMIT_STRICT=true

# === CACHING ===
CACHE_TTL=1800  # 30 minutes
CACHE_MAX_SIZE=1000000

# === MONITORING ===
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d
JAEGER_ENDPOINT=http://jaeger-collector.monitoring:14268/api/traces
JAEGER_SAMPLING_RATE=0.1  # 10% sampling in production

# === FILE STORAGE ===
UPLOAD_MAX_SIZE=100MB
AUDIO_STORAGE_PATH=/data/audio
TTS_MODEL_CACHE_PATH=/data/models
STORAGE_ENCRYPTION=true

# === AI CONFIGURATION ===
MOCK_EXTERNAL_APIS=false
LLM_MAX_TOKENS=8000
LLM_TEMPERATURE=0.5  # More conservative in production
TTS_DEFAULT_VOICE=premium
TTS_DEFAULT_SPEED=1.0
AI_SAFETY_CHECKS=true

# === HEALTH CHECKS ===
HEALTH_CHECK_TIMEOUT=30
DEPENDENCY_TIMEOUT=10
HEALTH_CHECK_INTERVAL=30

# === COMPLIANCE ===
DATA_RETENTION_DAYS=730  # 2 years
PII_ANONYMIZATION=true
GDPR_COMPLIANCE=true
AUDIT_RETENTION_DAYS=2555  # 7 years

# === BACKUP ===
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION=true

# === SSL/TLS ===
TLS_ENABLED=true
TLS_CERT_PATH=/etc/ssl/certs
TLS_KEY_PATH=/etc/ssl/private
HSTS_ENABLED=true

# === RESOURCE LIMITS ===
MAX_MEMORY_USAGE=2Gi
MAX_CPU_USAGE=2000m
DISK_USAGE_LIMIT=80%

# === ALERTING ===
ALERT_EMAIL=${ALERT_EMAIL}  # Set via secrets
SLACK_WEBHOOK=${SLACK_WEBHOOK}  # Set via secrets
ERROR_THRESHOLD=1%
LATENCY_THRESHOLD=1000ms