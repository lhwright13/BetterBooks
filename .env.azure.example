# Azure OpenAI Migration - Example Environment Configuration
# Copy to .env and fill in your actual Azure OpenAI values

# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-01-preview

# Database Configuration
DATABASE_URL=postgresql://betterbooks:testpassword123@localhost:5432/betterbooks

# Security Configuration  
JWT_SECRET_KEY=test-secret-key-for-local-development

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Database credentials for Docker Compose
POSTGRES_DB=betterbooks
POSTGRES_USER=betterbooks
POSTGRES_PASSWORD=betterbooks

# Service URLs (for local Docker development)
CONTEXT_SERVICE_URL=http://context_service:8000
LLM_GATEWAY_URL=http://llm_gateway:8000
TTS_SERVICE_URL=http://tts_service:8000
TRANSCRIPTION_SERVICE_URL=http://transcription_service:8003