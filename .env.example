# EchoWright Platform Environment Configuration
# Copy this file to .env and fill in your actual values
# This is the main environment file for docker-compose

# ==============================================
# CRITICAL: API KEYS AND SECRETS
# ==============================================
# Google Gemini API Key (Required)
GEMINI_API_KEY=your-google-gemini-api-key-here

# Optional AI Provider Keys
OPENAI_API_KEY=your-openai-api-key-here-optional
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here-optional
ASSEMBLYAI_API_KEY=your-assemblyai-api-key-here-optional

# Security Keys
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-min-32-chars
ENCRYPTION_KEY=your-encryption-key-for-sensitive-data-32-chars-exactly

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
POSTGRES_USER=betterbooks
POSTGRES_PASSWORD=your-secure-database-password-here
POSTGRES_DB=betterbooks
DATABASE_URL=postgresql://betterbooks:your-secure-database-password-here@postgres:5432/betterbooks

# ==============================================
# SERVICE CONFIGURATION
# ==============================================
# Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=true

# CORS Origins (comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:4200

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ==============================================
# AI CONFIGURATION
# ==============================================
# Model Settings
DEFAULT_LLM_MODEL=gemini-pro
MAX_CONTEXT_TOKENS=4000
LLM_TEMPERATURE=0.7

# Content Safety
ENABLE_CONTENT_FILTERING=true
SAFETY_THRESHOLD=BLOCK_MEDIUM_AND_ABOVE

# ==============================================
# AUDIO CONFIGURATION
# ==============================================
# Audio Storage
AUDIO_FILES_PATH=./book_files
MAX_AUDIO_UPLOAD_MB=100

# TTS Settings
DEFAULT_VOICE=en_US-female-1
AUDIO_QUALITY=high
ENABLE_AUDIO_CACHING=true

# ==============================================
# CACHING CONFIGURATION
# ==============================================
REDIS_URL=redis://redis:6379/0
CACHE_TTL_HOURS=24
ENABLE_RESPONSE_CACHING=true

# ==============================================
# MONITORING AND LOGGING
# ==============================================
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_METRICS=true
ENABLE_TRACING=false

# Health Check Settings
HEALTH_CHECK_TIMEOUT=30
HEALTH_CHECK_INTERVAL=60

# ==============================================
# MOBILE APP CONFIGURATION
# ==============================================
# API Base URL for mobile app
API_BASE_URL=http://localhost:8000
WEB_APP_URL=http://localhost:8080

# Push Notifications (optional)
FIREBASE_PROJECT_ID=your-firebase-project-id-optional
FIREBASE_PRIVATE_KEY=your-firebase-private-key-optional

# ==============================================
# DEVELOPMENT SETTINGS
# ==============================================
# Hot Reload and Development
ENABLE_HOT_RELOAD=true
ENABLE_DEBUG_ROUTES=true
MOCK_EXTERNAL_SERVICES=false

# Testing
ENABLE_TEST_DATA=true
TEST_USER_EMAIL=test@echowright.com