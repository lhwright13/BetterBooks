# BetterBooks Platform Environment Configuration
# Copy this file to .env and fill in your actual values
#
# LOCAL-FIRST PHILOSOPHY:
# This platform is designed to run 100% locally without any cloud APIs.
# Cloud services are optional upgrades for production deployments.

# ==============================================
# LLM CONFIGURATION (choose one)
# ==============================================

# OPTION 1: Local Ollama (FREE - default for development)
# Install: https://ollama.ai
# Run: ollama serve && ollama pull llama3.2
USE_OLLAMA=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2                    # Options: llama3.2, tinyllama, mistral, etc.

# OPTION 2: Azure OpenAI (cloud - requires subscription)
# Uncomment and set USE_OLLAMA=false to use Azure
# USE_OLLAMA=false
# AZURE_OPENAI_API_KEY=your-azure-openai-api-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ==============================================
# STORAGE CONFIGURATION (choose one)
# ==============================================

# OPTION 1: Local filesystem (FREE - default)
# Files served from ./book_files directory
STORAGE_BACKEND=local
BOOK_FILES_DIR=./book_files

# OPTION 2: AWS S3 (cloud)
# Uncomment to use S3 storage
# STORAGE_BACKEND=s3
# AWS_S3_BUCKET_NAME=your-bucket-name
# AWS_REGION=us-east-1
# AWS_CLOUDFRONT_DOMAIN=your-cloudfront-domain.cloudfront.net  # Optional CDN

# OPTION 3: Azure Blob Storage (cloud)
# Uncomment to use Azure storage
# STORAGE_BACKEND=azure
# AZURE_STORAGE_ACCOUNT_NAME=your-storage-account
# AZURE_STORAGE_ACCOUNT_KEY=your-storage-key
# AZURE_CDN_ENDPOINT=https://your-cdn.azureedge.net  # Optional CDN

# ==============================================
# VOICE/SPEECH CONFIGURATION (choose one each)
# ==============================================

# Speech-to-Text (STT) for voice input:
# OPTION 1: Local Whisper (FREE - default)
# Requires: pip install faster-whisper
STT_BACKEND=local
WHISPER_MODEL=base                       # Options: tiny, base, small, medium, large

# OPTION 2: OpenAI Whisper API (cloud)
# STT_BACKEND=openai
# OPENAI_API_KEY=your-openai-api-key

# OPTION 3: Azure Speech (cloud)
# STT_BACKEND=azure
# AZURE_SPEECH_KEY=your-speech-key
# AZURE_SPEECH_REGION=eastus

# ==============================================
# RUNTIME TRANSCRIPTION (for audiobook context)
# ==============================================
# Transcribes audio files on-demand to provide context for AI chat.
# Only transcribes up to the user's current position (no spoilers).
# Results are cached to avoid re-transcribing.

# OPTION 1: Local Whisper (FREE - default)
# Requires: pip install openai-whisper
# Also recommended: ffmpeg (for audio segment extraction)
TRANSCRIPTION_BACKEND=local
# WHISPER_MODEL=base                     # Uses same model as STT above

# OPTION 2: OpenAI Whisper API (faster, paid)
# TRANSCRIPTION_BACKEND=openai
# OPENAI_API_KEY=your-openai-api-key     # Same key as STT if using OpenAI

# OPTION 3: Azure Speech-to-Text (enterprise)
# TRANSCRIPTION_BACKEND=azure
# AZURE_SPEECH_KEY=your-speech-key       # Same as STT Azure config
# AZURE_SPEECH_REGION=eastus

# Transcription cache directory (optional - defaults to book_files/.cache/transcripts)
# TRANSCRIPTION_CACHE_DIR=./cache/transcripts

# Text-to-Speech (TTS):
# OPTION 1: Local Coqui TTS (FREE - default)
# Requires: pip install TTS
TTS_BACKEND=local

# OPTION 2: OpenAI TTS (cloud)
# TTS_BACKEND=openai
# OPENAI_API_KEY=your-openai-api-key      # Same key as STT if using OpenAI

# OPTION 3: ElevenLabs (cloud - high quality voices)
# TTS_BACKEND=elevenlabs
# ELEVENLABS_API_KEY=your-elevenlabs-key

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
POSTGRES_USER=betterbooks
POSTGRES_PASSWORD=betterbooks            # Change in production!
POSTGRES_DB=betterbooks
DATABASE_URL=postgresql://betterbooks:betterbooks@localhost:5432/betterbooks

# ==============================================
# SECURITY CONFIGURATION
# ==============================================
JWT_SECRET_KEY=dev-secret-key-change-in-production-min-32-chars

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8080

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ==============================================
# CACHING (optional but recommended)
# ==============================================
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_HOURS=24
ENABLE_RESPONSE_CACHING=true

# ==============================================
# LOGGING AND MONITORING
# ==============================================
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_METRICS=true
ENABLE_TRACING=false

# ==============================================
# DEVELOPMENT SETTINGS
# ==============================================
ENVIRONMENT=development
DEBUG=true
ENABLE_HOT_RELOAD=true
ENABLE_DEBUG_ROUTES=true