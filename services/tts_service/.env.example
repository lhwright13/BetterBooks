# TTS Service Environment Configuration
# Copy this file to .env and fill in your actual values

# Service Configuration
TTS_SERVICE_HOST=0.0.0.0
TTS_SERVICE_PORT=8000
DEBUG=false

# TTS Provider Configuration
GEMINI_API_KEY=your-google-gemini-api-key-here
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here-optional
COQUI_TTS_MODEL_PATH=/app/models/coqui

# Voice Configuration
DEFAULT_VOICE=en_US-female-1
VOICE_SPEED=1.0
VOICE_PITCH=0.0
AUDIO_FORMAT=mp3
AUDIO_QUALITY=high

# Audio Caching
ENABLE_AUDIO_CACHE=true
CACHE_TTL_HOURS=168
CACHE_MAX_SIZE_MB=1000
AUDIO_CACHE_PATH=/app/audio_cache

# Performance Settings
MAX_TEXT_LENGTH=5000
CONCURRENT_SYNTHESIS_LIMIT=5
SYNTHESIS_TIMEOUT=60

# Audio Processing
ENABLE_AUDIO_COMPRESSION=true
NORMALIZE_AUDIO=true
REMOVE_SILENCE=true

# Monitoring
LOG_LEVEL=INFO
TRACK_SYNTHESIS_METRICS=true
ENABLE_USAGE_ANALYTICS=true