# Context Service Environment Configuration  
# Copy this file to .env and fill in your actual values

# Service Configuration
CONTEXT_SERVICE_HOST=0.0.0.0
CONTEXT_SERVICE_PORT=8000
DEBUG=false

# Database Configuration
DATABASE_URL=postgresql://betterbooks:betterbooks@postgres:5432/betterbooks
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Vector Database Configuration
VECTOR_DIMENSION=768
VECTOR_INDEX_TYPE=hnsw
VECTOR_INDEX_M=16
VECTOR_INDEX_EF_CONSTRUCTION=200

# Embedding Configuration
EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_BATCH_SIZE=100
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Performance Settings
ENABLE_QUERY_CACHE=true
CACHE_TTL_MINUTES=60
MAX_CONCURRENT_QUERIES=50

# Content Processing
MAX_CONTENT_LENGTH=1000000
SUPPORTED_FORMATS=txt,pdf,epub,md

# Monitoring
LOG_LEVEL=INFO
ENABLE_QUERY_LOGGING=true
TRACK_EMBEDDING_USAGE=true