# API Gateway Environment Configuration
# Copy this file to .env and fill in your actual values

# Service Configuration
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8000
DEBUG=false

# Backend Service URLs
CONTEXT_SERVICE_URL=http://context_service:8000
LLM_GATEWAY_URL=http://llm_gateway:8000
TTS_SERVICE_URL=http://tts_service:8000
TRANSCRIPTION_SERVICE_URL=http://transcription_service:8003

# Database Configuration
DATABASE_URL=postgresql://betterbooks:betterbooks@postgres:5432/betterbooks

# Security Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Audio File Storage
AUDIO_FILES_PATH=/app/book_files
MAX_UPLOAD_SIZE_MB=100

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=30