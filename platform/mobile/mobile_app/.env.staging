# Staging Environment Configuration
API_BASE_URL=http://128.203.92.141:8000
ENVIRONMENT=staging
ENABLE_DETAILED_LOGGING=true
ENABLE_MOCK_DATA=false
APP_NAME=EchoWright (Staging)

# Network Configuration
