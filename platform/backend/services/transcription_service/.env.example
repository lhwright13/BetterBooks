# Transcription Service Environment Configuration
# Copy this file to .env and fill in your actual values

# Service Configuration  
TRANSCRIPTION_SERVICE_HOST=0.0.0.0
TRANSCRIPTION_SERVICE_PORT=8003
DEBUG=false

# Speech-to-Text Provider Configuration
ASSEMBLYAI_API_KEY=your-assemblyai-api-key-here-optional
OPENAI_API_KEY=your-openai-api-key-for-whisper-optional
GOOGLE_SPEECH_API_KEY=your-google-speech-api-key-optional

# Audio Processing Configuration
SUPPORTED_FORMATS=wav,mp3,m4a,flac,ogg
MAX_AUDIO_SIZE_MB=25
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1

# Transcription Settings
LANGUAGE_CODE=en-US
ENABLE_SPEAKER_DIARIZATION=true
ENABLE_PUNCTUATION=true
ENABLE_PROFANITY_FILTER=false

# Real-time Processing
ENABLE_STREAMING=true
CHUNK_DURATION_MS=1000
SILENCE_THRESHOLD=0.01

# Performance Settings
MAX_CONCURRENT_TRANSCRIPTIONS=10
TRANSCRIPTION_TIMEOUT=300
ENABLE_VAD=true

# Result Caching
ENABLE_TRANSCRIPTION_CACHE=true
CACHE_TTL_HOURS=24
CACHE_MAX_ENTRIES=1000

# Monitoring
LOG_LEVEL=INFO
TRACK_TRANSCRIPTION_ACCURACY=true
ENABLE_PERFORMANCE_METRICS=true